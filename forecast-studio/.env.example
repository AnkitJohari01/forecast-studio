# Port the app is published on (http://<host>:WEB_PORT)
WEB_PORT=8080
# API web workers and per-worker parallel model processes. 2 x 2 suits a 2 vCPU / 4 GB host.
WEB_CONCURRENCY=2
POOL_WORKERS=2
# Request limits
MAX_SERIES=50
MAX_POINTS=1000
CACHE_SIZE=512
# Only needed if the frontend is hosted on a different domain than the API (comma separated)
ALLOWED_ORIGINS=
LOG_LEVEL=INFO
